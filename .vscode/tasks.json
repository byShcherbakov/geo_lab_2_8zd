{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lab 2: build and run",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/run-macos.sh"
      ],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/run-windows.ps1"
        ]
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}